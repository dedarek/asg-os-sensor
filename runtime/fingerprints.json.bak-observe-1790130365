n flushStream(partID, reason) {\n  const flushed = [];\n  for (const key of Array.from(streams.keys())) {\n    if (partID && key.indexOf(\"|\" + String(partID) + \"|\") === -1) continue;\n    const entry = streams.get(key);\n    streams.delete(key);\n    if (!entry || entry.count === 0) continue;\n    flushed.push(entry);\n    record(\"assistant.stream.delta\", {\n      session_id: entry.session_id,\n      content_complete: false,\n      payload: entry.text,\n      detail: {\n        message_id: entry.message_id,\n        part_id: entry.part_id,\n        field: entry.field,\n        delta_count: entry.count,\n        coalesced: true,\n        coalesce_window_ms: Math.max((entry.updated_at || entry.started_at) - entry.started_at, 1),\n        delta_bytes: entry.bytes,\n        retained_bytes: Buffer.byteLength(entry.text, \"utf8\"),\n        truncated: entry.truncated,\n        truncation: entry.truncated ? { reason: \"max_field_bytes\", limit_bytes: MAX_FIELD_BYTES, full_bytes: entry.bytes } : null,\n        content_complete: false,\n        flush_reason: reason,\n        capture_layer: \"target-bus-delta-stream\",\n        origin: \"message.part.delta\",\n        note: \"coalesced stream parts, not the final text; the complete text is emitted as assistant.output at stream end\"\n      }\n    });\n  }\n  return flushed;\n}\n\nfunction flushAllStreams(reason) {\n  const ids = new Set();\n  for (const key of Array.from(streams.keys())) ids.add(key.split(\"|\")[1]);\n  for (const id of ids) flushStream(id, reason);\n}\n\nfunction addMessageText(messageID, text) {\n  if (!messageID || typeof text !== \"string\" || text.length === 0) return null;\n  const entry = messageText.get(messageID) || { text: \"\", bytes: 0, truncated: false };\n  entry.bytes += Buffer.byteLength(text, \"utf8\");\n  if (!entry.truncated) {\n    const next = entry.text + text;\n    if (Buffer.byteLength(next, \"utf8\") > MAX_FIELD_BYTES) {\n      entry.truncated = true;\n      entry.text = Buffer.