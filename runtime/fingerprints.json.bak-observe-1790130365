ontent_complete: false,\n        payload: { error: state.error === undefined ? null : state.error, metadata: state.metadata === undefined ? null : state.metadata },\n        detail: Object.assign({}, base, {\n          control_mode: MODE,\n          reason: \"no tool.execute.before reached this Hook for this call_id, so the call was aborted by another ASG decision gate at the native trigger\",\n          pairing_note: \"counted in sibling_blocked_calls at the io.turn.end checkpoint instead of being reported as a lost tool.execute.after\",\n          capture_layer: \"target-bus-part\",\n          origin: \"message.part.updated\"\n        })\n      });\n      return;\n    }\n    record(\"tool.error\", {\n      tool: toolName,\n      call_id: callID,\n      session_id: sessionID,\n      turn_id: turn ? turn.turn_id : null,\n      agent_id: turn ? turn.agent_id : DEFAULT_AGENT_ID,\n      content_complete: true,\n      payload: { error: state.error === undefined ? null : state.error, metadata: state.metadata === undefined ? null : state.metadata },\n      detail: Object.assign({}, base, { time: state.time === undefined ? null : redact(state.time, 0) })\n    });\n    return;\n  }\n  record(\"tool.part\", {\n    tool: toolName,\n    call_id: callID,\n    session_id: sessionID,\n    turn_id: turn ? turn.turn_id : null,\n    agent_id: turn ? turn.agent_id : DEFAULT_AGENT_ID,\n    content_complete: state.status === \"completed\",\n    payload: state.output === undefined ? null : state.output,\n    detail: Object.assign({}, base, {\n      title: state.title || null,\n      output_bytes: typeof state.output === \"string\" ? Buffer.byteLength(state.output, \"utf8\") : null,\n      metadata: state.metadata === undefined ? null : redact(state.metadata, 0),\n      time: state.time === undefined ? null : redact(state.time, 0),\n      return_value_modified: false\n    })\n  });\n}\n\nfunction onEvent(event) {\n  const type = event && typeof event.type === \"string\" ? event.type : \"