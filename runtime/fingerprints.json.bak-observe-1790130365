         "content": "/**\n * asg-observer — ASG 观测与工具门控 Hook（Cordis 插件，dsh profile 局部）\n *\n * 挂接方式：本 profile 的 cordis.patch.yml 追加一条 insert 项\n *   id: asg-observer, name: ./plugins/asg-observer.mjs\n * 启动器在 patchReload: live 下监视 cordis.patch.yml，写入即热挂接；\n * loader 的 import() 以 profile 目录为 baseUrl 解析 ./ 相对名\n * （见 @deepseek-ai/cordis-plugin-loader 的 EntryTree.import）。\n *\n * 事件名与载荷形状取自本安装内第一方实现：\n *   tools/pre-execute      ctx.waterfall 门控，监听器 (exec, next)，返回\n *                          allow / deny+reason / ask\n *   tools/result           只读最终结果 (exec, result)，exec 含 name/callId/arguments/agent\n *   session/event          持久会话事件 (subject, event)，event.type 为\n *                          user/message 或 assistant/message，event.seq 为持久序号\n *   agent/request          解析后的请求路由（waterfall，必须原样返回 next() 结果）\n *   agent/assistant-stream frame：start/chunk/end，含 attemptId/turn/step\n *\n * 约定：事件投递绝不改变目标回调返回值；控制客户端失败时按控制模式 fail-closed。\n * 客户端与其配置由安装包提供，可用 ASG_HOOK_CLIENT（JSON 数组）覆盖。\n */\nimport { spawn } from 'node:child_process'\nimport { appendFileSync } from 'node:fs'\nimport { dirname, join } from 'node:path'\nimport { fileURLToPath } from 'node:url'\n\nconst name = 'asg-observer'\nconst inject = []\n\nconst here = dirname(fileURLToPath(import.meta.url))\nconst logPath = process.env.ASG_OBSERVER_LOG || join(here, 'asg-observer.jsonl')\nconst mode = process.env.ASG_HOOK_MODE === 'observe' ? 'observe' : 'control'\nconst maxBytes = Number(process.env.ASG_HOOK_MAX_CONTENT || 32768)\n\n// 控制客户端：优先环境变量，其次安装包提供的 client_command（来自 supervisor 控制契约）。\nconst clientCommand = (() => {\n  const raw = process.env.ASG_HOOK_CLIENT\n  if (raw) {\n    try { return JSON.parse(raw) } catch { /* 回退到内置命令 */ }\n  }\n  return [\n    '/Library/Developer/CommandLineTools/usr/bin/python3',\n    '/Users/mac/个人项目/asg-os-sensor-advisor-20260911/runtime/hook_control_client.py',\n    '/Users/mac/个人项目/asg-os-sensor-advisor-20260911/artifacts/stage1/dashboard/hook-control-client.json',\n  ]\n})()\n\nconst pid = process.pid\nlet sequence = 0\nconst clock = () => new Date().toISOString()\nconst NL = String.fromCharCode(10)\n\nconst write = (record) => {\n  try { appendFileSync(logPath, JSON.stringify(record) + NL) } catch { /* 观测不得影响宿主 */ }\n}\n\nconst bounded = (value) => {\n  if (value === undefined || value === null) return { content: null, complete: true }\n  let text\n  try { text = typeof value === 'string' ? value : JSON.stringify(value) } catch { text = String(value) }\n  if (text.length <= maxBytes) return { content: value, complete: true }\n  return { content: text.slice(0, maxBytes), complete: false }\n}\n\nconst client = (action, payload) => new Promise((resolve) => {\n  let child\n  try {\n    child = spawn(clientCommand[0], [...clientCommand.slice(1), action], { stdio: ['pipe', 'pipe', 'pipe'] })\n  } catch (error) { resolve({ ok: false, code: null, stdout: '', stderr: String(error) }); return }\n  let stdout = ''\n  let stderr = ''\n  const fail = (error) => { stderr += String((error && error.message) || error) }\n  child.stdout.on('data', (d) => { stdout += d })\n  child.stderr.on('data', (d) => { stderr += d })\n  child.on('error', fail)\n  child.on('close', (code) => resolve({ ok: code === 0 && !child.killed, code, stdout, stderr }))\n  try {\n    child.stdin.end(JSON.stringify(payload))\n  } catch (error) {\n    fail(error)\n    try { child.kill() } catch { /* 已退出 */ }\n    resolve({ ok: false, code: null, stdout, stderr })\n  }\n})\n\nconst parse = (stdout) => {\n  try { const value = JSON.parse(stdout); return value && typeof value === 'object' ? value : {} } catch { return {} }\n}\n\n// 归一化事件：写本地证据日志，并以 action=event 交给通用控制客户端（不改变回调返回值）。\nconst publish = (partial) => {\n  const record = {\n    source: 'asg-observer',\n    event: partial.event,\n    pid,\n    timestamp: clock(),\n    session_id: partial.session_id ?? null,\n    turn_id: partial.turn_id ?? null,\n    step: partial.step ?? null,\n    event_id: partial.event_id ?? (partial.event + ':' + pid + ':' + (sequence + 1)),\n    sequence: ++sequence,\n    tool: partial.tool ?? null,\n    call_id: partial.call_id ?? null,\n    content: partial.content ?? null,\n    content_complete: partial.content_complete ?? true,\n  }\n  write(record)\n  client('event', record).then((res) => {\n    if (!res.ok) {\n      write({ source: 'asg-observer', event: 'hook.delivery.error', pid, timestamp: clock(), action: 'event',\n        exit_code: res.code, stderr: String(res.stderr).slice(0, 2000), content_complete: true })\n    }\n  }).catch(() => { /* 投递失败不得影响宿主 */ })\n  return record\n}\n\nconst idOf = (value) => (value && (value.id || value.sessionId)) || null\n\nfunction apply (ctx) {\n  // ── 1. 持久会话事件：user.input / model.response / assistant.output ──\n  ctx.on('session/event', (subject, event) => {\n    const type = event && event.type\n    if (type !== 'user/message' && type !== 'assistant/message') return\n    try {\n      const data = (event && event.data) || {}\n      const message = data.message || data\n      const sessionId = idOf(subject)\n      const turn = data.turn ?? message.turn ?? null\n      const step = data.step ?? message.step ?? null\n      const body = bounded(message.content ?? null)\n      const base = {\n        session_id: sessionId,\n        turn_id: turn,\n        step,\n        event_id: (sessionId ?? 'unknown') + ':' + (event.seq ?? 'noseq') + ':' + type,\n        call_id: message.id ?? null,\n        content: body.content,\n        content_complete: body.complete,\n      }\n      publish({ ...base, event: type === 'user/message' ? 'user.input' : 'model.response' })\n      if (type === 'assistant/message') {\n        const blocks = Array.isArray(message.content) ? message.content : []\n        const texts = blocks.filter((block) => block && block.type === 'text').map((block) => block.text)\n        if (texts.length > 0) {\n          const out = bounded(texts.join(NL))\n          publish({ ...base, event: 'assistant.output', content: out.content, content_complete: out.complete })\n        }\n      }\n    } catch { /* 观测不得影响会话 */ }\n  })\n\n  // ── 2. 模型请求路由（waterfall：必须原样返回 next() 结果）──\n  ctx.on('agent/request', async (payload, next) => {\n    const resolved = await next()\n    try {\n      publish({\n        event: 'model.request',\n        session_id: idOf((payload && payload.agent && payload.agent.session) || (payload && payload.session)),\n        turn_id: (payload && payload.turn) ?? null,\n        step: (payload && payload.step) ?? null,\n        content: {\n          provider: (resolved && resolved.provider) ?? null,\n          model: (resolved && resolved.model) ?? null,\n          reasoningEffort: (resolved && resolved.reasoningEffort) ?? null,\n        },\n        content_complete: true,\n      })\n    } catch { /* 观测不得影响路由 */ }\n    return resolved\n  })\n\n  // ── 3. 工具执行前：同步 decision 门控 ──\n  ctx.on('tools/pre-execute', async (exec, next) => {\n    // 先让目标自身策略（sandbox / approval / 其它 guard）决定，绝不放宽上游拒绝。\n    const inner = await next()\n    const callId = exec && exec.callId !== undefined ? String(exec.callId) : null\n    const sessionId = idOf(exec && exec.agent && exec.agent.session)\n    const args = bounded(exec ? exec.arguments : null)\n    const toolName = (exec && exec.name) || 'tool'\n    const base = {\n      event: 'tool.execute.before',\n      tool: (exec && exec.name) || null,\n      call_id: callId,\n      session_id: sessionId,\n      event_id: (sessionId ?? 'unknown') + ':' + (callId ?? 'nocall') + ':tool.execute.before',\n    }\n    if (inner && inner.kind === 'deny') {\n      publish({ ...base, content: { decision: 'denied-upstream', reason: inner.reason ?? null, arguments: args.content }, content_complete: args.complete })\n      return inner\n    }\n    if (mode === 'observe') {\n      publish({ ...base, content: { decision: 'observe-only', inner: inner ? inner.kind : null, arguments: args.content }, content_complete: args.complete })\n      return inner\n    }\n    let res = { ok: false, code: null, stdout: '', stderr: 'decision not attempted' }\n    try {\n      res = await client('decision', { pid, call_id: callId ?? '', tool: (exec && exec.name) ?? '', input: (exec && exec.arguments) ?? {} })\n    } catch (error) {\n      res = { ok: false, code: null, stdout: '', stderr: String((error && error.message) || error) }\n    }\n    const parsed = parse(res.stdout)\n    const decision = res.ok ? String(parsed.decision ?? 'deny') : 'deny'\n    if (decision !== 'allow') {\n      const detail = res.ok ? ('returned ' + JSON.stringify(decision)) : 'unavailable'\n      const reason = 'ASG control ' + detail + '; blocked ' + toolName\n      const denyAck = parsed.request_id\n        ? await client('ack', { request_id: parsed.request_id, applied: true, outcome: 'blocked' })\n        : { ok: false, code: null, stderr: 'no request_id' }\n      publish({ ...base, content: { decision, reason, request_id: parsed.request_id ?? null,\n        control_exit_code: res.code, control_stderr: String(res.stderr).slice(0, 2000),\n        enforcement_applied: true, enforcement_outcome: 'blocked', deny_ack_ok: !!denyAck.ok,\n        arguments: args.content }, content_complete: true })\n      // 同步阻断：先确认阻断回执，再返回 deny；目标管线不会 dispatch 该工具体。\n      return { kind: 'deny', reason }\n    }\n    if (parsed.request_id) {\n      client('ack', { request_id: parsed.request_id, applied: true, outcome: 'allowed' }).catch(() => {})\n    }\n    publish({ ...base, content: { decision: 'allow', request_id: parsed.request_id ?? null, arguments: args.content }, content_complete: args.complete })\n    return inner\n  })\n\n  // ── 4. 工具执行后：只读最终结果 ──\n  ctx.on('tools/result', (exec, result) => {\n    try {\n      const body = bounded(result ? result.content : null)\n      const sessionId = idOf(exec && exec.agent && exec.agent.session)\n      const callId = exec && exec.callId !== undefined ? String(exec.callId) : null\n      publish({\n        event: 'tool.execute.after',\n        tool: (exec && exec.name) || null,\n        call_id: callId,\n        session_id: sessionId,\n        event_id: (sessionId ?? 'unknown') + ':' + (callId ?? 'nocall') + ':tool.execute.after',\n        content: { isError: !!(result && result.isError), error: (result && result.error && result.error.message) || null, result: body.content },\n        content_complete: body.complete,\n      })\n    } catch { /* 观测不得影响结果 */ }\n  })\n\n  // ── 5. 流式尝试的 turn/step 关联（仅索引，不重放内容）──\n  const attempts = new Map()\n  ctx.on('agent/assistant-stream', (payload) => {\n    const frame = payload && payload.frame\n    if (!frame || typeof frame.attemptId !== 'string') return\n    if (frame.type === 'start') {\n      if (attempts.size > 512) attempts.clear()\n      attempts.set(frame.attemptId, { turn: frame.turn ?? null, step: frame.step ?? null })\n    } else if (frame.type === 'end') {\n      attempts.delete(frame.attemptId)\n    }\n  })\n\n  write({ source: 'asg-observer', event: 'hook.loaded', pid, timestamp: clock(), mode, log_path: logPath, content_complete: true })\n}\n\nexport { apply, inject, name }\n",
