ete output is claimed for it\",\n        capture_layer: \"target-bus-event\",\n        origin: \"server-event\"\n      }\n    });\n    return;\n  }\n  if (type === \"message.removed\") {\n    record(\"session.lifecycle\", {\n      session_id: sessionID,\n      agent_id: agentId,\n      content_complete: false,\n      payload: properties,\n      detail: { phase: \"update\", event_type: type, capture_layer: \"target-bus-event\", origin: \"server-event\" }\n    });\n    return;\n  }\n  if (type === \"session.idle\") {\n    if (turn && turn.pending_tool_calls.size === 0) checkpoint(turn, \"session.idle\", false);\n    record(\"session.lifecycle\", {\n      session_id: sessionID,\n      agent_id: agentId,\n      content_complete: true,\n      payload: properties,\n      detail: { phase: \"update\", event_type: type, capture_layer: \"target-bus-event\", origin: \"server-event\" }\n    });\n    return;\n  }\n  if (type.indexOf(\"error\") !== -1) {\n    record(\"error\", {\n      session_id: sessionID,\n      turn_id: turn ? turn.turn_id : null,\n      agent_id: agentId,\n      content_complete: true,\n      payload: properties,\n      detail: { event_type: type, capture_layer: \"target-bus-event\", origin: \"server-event\" }\n    });\n    return;\n  }\n  if (type === \"session.updated\" || type === \"session.status\") {\n    record(\"session.lifecycle\", {\n      session_id: sessionID,\n      turn_id: turn ? turn.turn_id : null,\n      agent_id: agentId,\n      content_complete: true,\n      payload: properties,\n      detail: { phase: \"update\", event_type: type, capture_layer: \"target-bus-event\", origin: \"server-event\" }\n    });\n    return;\n  }\n  const seen = (typeCounts.get(type) || 0) + 1;\n  typeCounts.set(type, seen);\n  if (seen <= UNKNOWN_EVENT_LIMIT) {\n    record(\"session.event\", {\n      session_id: sessionID,\n      turn_id: turn ? turn.turn_id : null,\n      agent_id: agentId,\n      content_complete: true,\n      payload: properties,\n      detail: