n      capture_layer: \"target-bus-reconstruction\",\n      transport_captured: false,\n      body_complete: false,\n      reconstruction: true,\n      coverage: \"assistant message rebuilt from server bus events (message.updated + message.part.* + experimental.text.complete); this is NOT the provider HTTP response body\",\n      text_bytes: text ? text.bytes : null,\n      text_truncated: text ? text.truncated : null,\n      origin: \"server-event\"\n    }\n  });\n  if (turn && turn.pending_tool_calls.size === 0) checkpoint(turn, \"assistant-message-completed-with-no-pending-tool-calls\", false);\n}\n\nfunction onPart(properties) {\n  const part = properties ? properties.part : null;\n  if (!part) return;\n  const sessionID = properties.sessionID || part.sessionID || null;\n  const turn = turnFor(sessionID, false, null, null);\n  const partID = part.id ? String(part.id) : null;\n  const partType = part.type || \"unknown\";\n  const finished = !!(part.time && part.time.end);\n  const messageID = part.messageID ? String(part.messageID) : null;\n  if (partType === \"text\") {\n    if (finished) {\n      watermarks.delete(\"part:\" + String(partID));\n      onTextComplete(sessionID, messageID, partID, part.text, \"message.part.updated\", null);\n      return;\n    }\n    if (!throttle(watermarks, \"part:\" + String(partID), COALESCE_MS)) return;\n    record(\"assistant.output.partial\", {\n      session_id: sessionID,\n      turn_id: turn ? turn.turn_id : null,\n      agent_id: turn ? turn.agent_id : DEFAULT_AGENT_ID,\n      content_complete: false,\n      payload: part.text === undefined ? null : part.text,\n      detail: {\n        message_id: messageID,\n        part_id: partID,\n        part_type: partType,\n        final: false,\n        coalesced: true,\n        coalesce_window_ms: COALESCE_MS,\n        capture_layer: \"target-bus-part\",\n        origin: \"message.part.updated\",\n        note: \"not the final text; the complete text is emitted as assistant.outp