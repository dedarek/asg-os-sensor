agentName);\n    }\n  }\n  return turn || null;\n}\n\nfunction bump(turn, key) {\n  if (turn) turn.counts[key] = (turn.counts[key] || 0) + 1;\n}\n\nfunction checkpoint(turn, reason, final) {\n  if (!turn) return;\n  if (turn.checkpointed && !final) return;\n  const expected = {\n    \"user.input\": turn.counts[\"user.input\"],\n    \"model.request\": turn.counts[\"model.request\"],\n    \"model.response\": turn.counts[\"model.response\"],\n    \"tool.execute.before\": turn.counts[\"tool.execute.before\"],\n    \"tool.execute.after\": turn.expected[\"tool.execute.after\"],\n    \"assistant.output\": turn.counts[\"assistant.output\"]\n  };\n  const actual = {};\n  for (const key of Object.keys(turn.counts)) actual[key] = turn.counts[key];\n  const mismatches = Object.keys(expected).filter(function (key) { return expected[key] !== actual[key]; });\n  record(\"io.turn.end\", {\n    session_id: turn.session_id,\n    turn_id: turn.turn_id,\n    agent_id: turn.agent_id,\n    content_complete: true,\n    payload: {\n      reason: reason,\n      final: !!final,\n      expected_counts: expected,\n      actual_counts: actual,\n      mismatches: mismatches,\n      pending_tool_calls: Array.from(turn.pending_tool_calls),\n      sibling_blocked_calls: turn.sibling_blocked,\n      agents_observed: Array.from(turn.agents),\n      last_sequence: sequence,\n      counters_origin: \"incremented inside the target callbacks at the ingress / call sites, not derived from delivered log rows\",\n      units: {\n        \"user.input\": \"one per accepted user input (chat.message; bus message.updated as fallback, deduplicated by message id)\",\n        \"model.request\": \"one per LLM call attempt observed at chat.params\",\n        \"model.response\": \"one per completed assistant message observed on the server bus (bus reconstruction, not the HTTP response body)\",\n        \"tool.execute.before\": \"one per tool call that reached this Hook's native pre-execution callback\",\n        \"tool