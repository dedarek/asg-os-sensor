  return existsSync(CONTROL_PYTHON) && existsSync(CONTROL_CLIENT) && existsSync(CONTROL_CONFIG);\n  } catch (error) {\n    noteError(\"control.exists\", error);\n    return false;\n  }\n}\n\nfunction runControlClient(argument, requestText) {\n  return spawnSync(CONTROL_PYTHON, [CONTROL_CLIENT, CONTROL_CONFIG, argument], {\n    input: requestText,\n    encoding: \"utf8\",\n    timeout: CONTROL_TIMEOUT_MS,\n    maxBuffer: 8 * 1024 * 1024\n  });\n}\n\nfunction lastJsonLine(stdout) {\n  if (typeof stdout !== \"string\") return null;\n  const lines = stdout.split(\"\\n\").filter(function (line) { return line.trim() !== \"\"; });\n  if (lines.length === 0) return null;\n  try {\n    return JSON.parse(lines[lines.length - 1]);\n  } catch (error) {\n    noteError(\"control.parse\", error);\n    return null;\n  }\n}\n\nfunction decisionInput(argsValue) {\n  if (argsValue === undefined) return null;\n  try {\n    const safe = redact(argsValue, 0);\n    JSON.stringify(safe);\n    return safe;\n  } catch (error) {\n    noteError(\"control.input\", error);\n    return bounded(argsValue).value;\n  }\n}\n\nfunction decide(tool, callID, argsValue) {\n  let result;\n  try {\n    result = runControlClient(\"decision\", JSON.stringify({\n      pid: process.pid,\n      call_id: callID,\n      tool: tool,\n      input: decisionInput(argsValue)\n    }));\n  } catch (error) {\n    noteError(\"control.spawn\", error);\n    return { decision: \"deny\", request_id: null, raw: null, error: \"spawn-failed\" };\n  }\n  const parsed = lastJsonLine(result.stdout);\n  if (result.error) {\n    noteError(\"control.transport\", result.error.message || result.error);\n    return { decision: \"deny\", request_id: parsed && parsed.request_id ? parsed.request_id : null, raw: null, error: \"transport-error\" };\n  }\n  if (result.status !== 0) {\n    noteError(\"control.exit\", \"status=\" + result.status + \" stderr=\" + String(result.stderr || \"\").slice(0, 2000));\n    return { decision: \"deny\", request_id: parsed && parsed.request_id ? parsed.request_id : null, raw: parsed ? parsed.decision : null, error: \"exit-status-\" + result.status };\n  }\n  if (!parsed) {\n    noteError(\"control.malformed\", String(result.stdout || \"\").slice(0, 2000));\n    return { decision: \"deny\", request_id: null, raw: null, error: \"malformed-response\" };\n  }\n  const raw = typeof parsed.decision === \"string\" ? parsed.decision.toLowerCase() : null;\n  const decision = raw === \"allow\" ? \"allow\" : \"deny\";\n  return { decision: decision, request_id: parsed.request_id ? parsed.request_id : null, raw: raw, error: decision === \"allow\" ? null : \"decision-\" + String(raw) };\n}\n\nfunction acknowledge(requestId, outcome) {\n  if (!requestId) return;\n  try {\n    const result = runControlClient(\"ack\", JSON.stringify({ request_id: requestId, applied: true, outcome: outcome }));\n    if (result.error || result.status !== 0) noteError(\"control.ack\", (result.error && result.error.message) || \"status=\" + result.status);\n  } catch (error) {\n    noteError(\"control.ack\", error);\n  }\n}\n\n/* Target-native pre-execution gate. deny path = throw (the native trigger does not catch it). */\nfunction gate(tool, callID, sessionID, turn, argsValue) {\n  const startedAt = Date.now();\n  const turnID = turn ? turn.turn_id : null;\n  const agentId = turn ? turn.agent_id : DEFAULT_AGENT_ID;\n  if (MODE !== \"sole-gate\") {\n    record(\"control.delegated\", {\n      tool: tool,\n      call_id: callID,\n      session_id: sessionID,\n      turn_id: turnID,\n      agent_id: agentId,\n      content_complete: true,\n      payload: {\n        sibling_gate_path: SIBLING.path,\n        sibling_gate_sha256: SIBLING.sha256,\n        sibling_gate_bytes: SIBLING.bytes,\n        decisions_made_by_this_hook: 0\n      },\n      detail: {\n        mode: MODE,\n        reason: \"another ASG decision gate is loaded in this process, so this Hook must not open a second gate for the same call\",\n  