# Copy to .env and fill in your own key. Never commit .env.
# ASG_ANALYST_ROUTE selects the route in llm.yaml (default: custom-openai).
ASG_ANALYST_ROUTE=custom-openai
# API key for the selected route key_env (here: ASG_ANALYST_API_KEY).
# Get it from your LLM provider console, then e.g.:
#   cp .env.example .env
# or export ASG_ANALYST_API_KEY=...
ASG_ANALYST_API_KEY=
# Optional: override model without editing llm.yaml
# ASG_ANALYST_MODEL=
# Optional: dashboard bind (defaults: 127.0.0.1:8080, 30s scan)
# ASG_PORT=
# ASG_SCAN_INTERVAL=
# ASG_MAX_ANALYSTS=2
# ASG_GOOSE_MAX_TURNS=12
# ASG_GOOSE_TIMEOUT=180
# ASG_GOOSE_RETRY_COOLDOWN=300
# ASG_GOOSE_BIN=
# ASG_AUTONOMOUS_ANALYSIS=1
# Optional sensor/event and local test endpoints
# ASG_INGEST_URL=http://127.0.0.1:8090/api/events/ingest
# ASG_EVENTS_FILE=events.jsonl
# ASG_AGENT_SCORE_THRESHOLD=50
# ASG_OTEL_HOST=127.0.0.1
# ASG_OTEL_PORT=4318
# ASG_OTEL_LOG=otel_hits.log
# Optional: emergency only, skip TLS verify when server cert is expired/broken
# ASG_INSECURE_SSL=1
# Explicit acknowledgement required before sending runtime findings over invalid TLS:
# ASG_ALLOW_INSECURE_ANALYST=1
# ASG_LLM_PROXY_HOST=127.0.0.1
# ASG_LLM_PROXY_PORT=0
